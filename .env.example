# Copy to .env and fill in. Never commit .env — see .gitignore.

# Set to 1 to run entirely offline against on-disk fixtures (see fixtures/, lib/demo-mode.*).
DEMO_MODE=0

# Where this app is deployed once `make deploy` has run — used by the keepalive workflow
# and by the Playwright demo recorder.
DEPLOY_URL=http://localhost:3000

# Postgres connection string (web2, web3). Default: a free Neon (https://neon.tech) database.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Hosted model API key (aiml). Never committed, never required when DEMO_MODE=1.
MODEL_API_KEY=

# Chain read access (web3). An Alchemy or Infura HTTPS RPC URL for your target testnet — see
# docs/RPC.md. Empty means "use viem's own public default RPC" — fine for local dev, never
# for a real indexing run.
RPC_URL=
# The contract the indexer watches, and the block it was deployed at (indexing from 0 burns
# your RPC quota re-scanning empty history).
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0
CHAIN_ID=10143
# Shared secret the /api/cron/catchup route checks against Vercel's own cron invoker header.
CRON_SECRET=

# Envio HyperSync token for the vault event feed on /proof (https://envio.dev/app/api-tokens).
ENVIO_API_TOKEN=
# Model for the agent: any OpenAI-compatible chat API with tool calling. The deployment uses Groq.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# The demo vendor that claims on chain in tools/agent.ts (throwaway, testnet only).
VENDOR_PRIVATE_KEY=
# Optional: a Qwen Cloud key puts Qwen 3.8 Max first, with the model above as fallback.
QWEN_API_KEY=
