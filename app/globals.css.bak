@import "tailwindcss";

/* Overwritten by apply-theme.py from templates/_ui/<theme>/globals.css (CONTRACTS B.5).
   Default fallback tokens use the Editorial Fintech & Swiss-Grid Light System. */
:root {
  --bg: #f5f5f5;
  --fg: #171717;
  --fg-muted: #525252;
  --surface: #ffffff;
  --surface-raised: #fafafa;
  --border: #e5e5e5;
  --accent: #059669;
  --accent-contrast: #ffffff;
  --radius: 0.75rem;
  --radius-sm: 0.5rem;
  --shadow: 0 1px 2px rgba(10, 10, 10, 0.05);
}

@theme inline {
  --color-background: var(--bg);
  --color-foreground: var(--fg);
  --font-sans: var(--font-sans);
}

body {
  background: var(--bg);
  color: var(--fg);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

.num {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

.display {
  font-weight: 500;
  letter-spacing: -0.03em;
  line-height: 1.04;
}

.dotgrid {
  background-image: radial-gradient(rgba(23, 23, 23, 0.08) 1px, transparent 1px);
  background-size: 20px 20px;
}
