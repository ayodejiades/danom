{
  "baseUrl": "${DEPLOY_URL}",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "steps": [
    {
      "say": "An agent that never holds the money",
      "goto": "/",
      "waitMs": 20020
    },
    {
      "say": "Open the live agent",
      "click": "[data-demo='open-agent']",
      "waitFor": "[data-demo='llm-run']",
      "waitMs": 13030
    },
    {
      "say": "An injected instruction: pay a stranger",
      "click": "[data-demo='llm-preset-3']",
      "waitMs": 11690
    },
    {
      "say": "Call the paid API without paying",
      "click": "[data-demo='x402-unpaid']",
      "waitFor": "[data-demo='x402-entry']",
      "waitMs": 7250
    },
    {
      "say": "Pay with the agent's signed voucher",
      "click": "[data-demo='x402-pay']",
      "waitMs": 11770
    },
    {
      "say": "Ask the live vault to pay the agent itself",
      "click": "[data-demo='x402-steal']",
      "waitMs": 7850
    },
    {
      "say": "Nineteen transactions on Monad testnet",
      "goto": "/proof#live",
      "waitMs": 10370
    },
    {
      "say": "Credit for agents, with limits you can check",
      "goto": "/",
      "waitMs": 10500
    }
  ]
}
