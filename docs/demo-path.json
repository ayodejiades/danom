{
  "baseUrl": "${DEPLOY_URL}",
  "viewport": { "width": 1920, "height": 1080 },
  "steps": [
    { "say": "An agent that can only spend where its sponsor allows", "goto": "/" },
    { "say": "Try the credit flow", "click": "[data-demo='launch-demo']", "waitFor": "[data-demo='list']" },
    { "say": "The agent tries to pay its own wallet and the vault refuses", "click": "#receiver", "select": { "#receiver": "0xA6E4700000000000000000000000000000000002" } },
    { "say": "Ask the vault to fund the vendor channel", "click": "[data-demo='trigger-escrow']", "waitFor": "[data-demo='row']" }
  ]
}
