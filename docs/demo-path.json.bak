{
  "baseUrl": "${DEPLOY_URL}",
  "viewport": { "width": 1920, "height": 1080 },
  "steps": [
    { "say": "Explore verified solution", "goto": "/" },
    { "say": "Launch the live workspace", "click": "[data-demo='launch-demo']", "waitFor": "[data-demo='list']" },
    { "say": "Lock payment and dispatch API call", "click": "[data-demo='trigger-escrow']", "fill": { "[data-demo='provider-input']": "0x4b2...e1f" } },
    { "say": "Verify SLA response and release settlement", "click": "[data-demo='submit']", "waitFor": "[data-demo='row']" }
  ]
}
