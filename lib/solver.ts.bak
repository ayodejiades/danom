/**
 * Deterministic Policy Engine, Multi-Party Cycle Solver, and Canonical EIP-712 Hasher.
 *
 * Architectural invariant ("The model never touches the money"):
 * 1. Off-chain agents or users propose a bounded SpendIntent.
 * 2. The 15-rule deterministic policy engine evaluates `(intent, policy, window)` as a pure function.
 * 3. The cycle solver finds 2-way and 3-way complementary netting cycles before routing only
 *    the residual to external liquidity.
 * 4. Every verdict is bound to a canonical EIP-712 digest verified on-chain before escrow moves.
 */
import { keccak256, toBytes, encodePacked } from "viem";

export interface SpendIntent {
  intentId: string;
  requester: `0x${string}`;
  recipient: `0x${string}`;
  sellAsset: string;
  buyAsset: string;
  amountUsd: number;
  maxSlippageBps: number;
  maxLatencyMs: number;
  reportedLatencyMs: number;
  category: string;
  vendorLcbScoreBps: number;
  nonce: number;
  timestamp: number;
  deadline: number;
}

export interface PolicyConfig {
  active: boolean;
  perCallCapUsd: number;
  dailyBudgetUsd: number;
  settledSpendTodayUsd: number;
  reservedAuthorityUsd: number;
  minVendorLcbBps: number;
  allowedCategories: string[];
  allowedRecipients: `0x${string}`[];
  allowedWorkers: `0x${string}`[];
  cooldownSeconds: number;
  lastServiceCallTimestamp: number;
  callsInLastHour: number;
  maxCallsPerHour: number;
  escalationThresholdUsd: number;
  seenNonces: number[];
  seenIntentKeys: string[];
}

export interface RuleResult {
  ruleId: string;
  passed: boolean;
  reason: string;
}

export interface PolicyEvaluation {
  verdict: "ALLOW" | "ESCALATE" | "BLOCK";
  passedCount: number;
  totalRules: number;
  rules: RuleResult[];
  effectiveDailyUsageUsd: number;
  canonicalDigest: `0x${string}`;
}

export const POLICY_RULE_NAMES = [
  "policy.active",
  "duplicate.provider_capability_amount_recipient",
  "cooldown.sameService",
  "replay.contextBinding",
  "recipient.allowDeny",
  "agent.workerAllowDeny",
  "category.allow",
  "vendor.lcbFloor",
  "intent.maxAmountBound",
  "hardCap.absolute",
  "perCall.cap",
  "budget.daily",
  "rate.limit",
  "sla.latencyBound",
  "escalate.aboveThreshold",
] as const;

export function computeCanonicalDigest(intent: SpendIntent, chainId = 84532): `0x${string}` {
  const packed = encodePacked(
    ["string", "address", "address", "string", "string", "uint256", "uint256", "uint256", "uint256"],
    [
      intent.intentId,
      intent.requester,
      intent.recipient,
      intent.sellAsset,
      intent.buyAsset,
      BigInt(Math.round(intent.amountUsd * 100)),
      BigInt(intent.nonce),
      BigInt(intent.deadline),
      BigInt(chainId),
    ]
  );
  return keccak256(packed);
}

/**
 * Evaluates all 15 deterministic policy rules in fixed order.
 * Pure function of (intent, policy, nowTimestamp). No LLM on the money path.
 */
export function evaluatePolicyRules(
  intent: SpendIntent,
  policy: PolicyConfig,
  nowTimestamp = intent.timestamp
): PolicyEvaluation {
  const intentKey = `${intent.recipient.toLowerCase()}:${intent.sellAsset}->${intent.buyAsset}:${intent.amountUsd}`;
  const effectiveUsage = policy.settledSpendTodayUsd + policy.reservedAuthorityUsd + intent.amountUsd;

  const rules: RuleResult[] = [
    {
      ruleId: "policy.active",
      passed: policy.active && nowTimestamp <= intent.deadline,
      reason: policy.active && nowTimestamp <= intent.deadline ? "Policy active and within TTL" : "Policy inactive or intent expired",
    },
    {
      ruleId: "duplicate.provider_capability_amount_recipient",
      passed: !policy.seenIntentKeys.includes(intentKey),
      reason: !policy.seenIntentKeys.includes(intentKey) ? "Unique intent tuple inside window" : "Duplicate task tuple refused inside TTL",
    },
    {
      ruleId: "cooldown.sameService",
      passed: nowTimestamp - policy.lastServiceCallTimestamp >= policy.cooldownSeconds,
      reason:
        nowTimestamp - policy.lastServiceCallTimestamp >= policy.cooldownSeconds
          ? `Cooldown satisfied (${nowTimestamp - policy.lastServiceCallTimestamp}s >= ${policy.cooldownSeconds}s)`
          : "Minimum service cooldown window not elapsed",
    },
    {
      ruleId: "replay.contextBinding",
      passed: !policy.seenNonces.includes(intent.nonce),
      reason: !policy.seenNonces.includes(intent.nonce) ? `Nonce ${intent.nonce} unused` : `Replay detected: nonce ${intent.nonce} already consumed`,
    },
    {
      ruleId: "recipient.allowDeny",
      passed: policy.allowedRecipients.some((r) => r.toLowerCase() === intent.recipient.toLowerCase()),
      reason: "Recipient verified against policy allowlist",
    },
    {
      ruleId: "agent.workerAllowDeny",
      passed: policy.allowedWorkers.some((w) => w.toLowerCase() === intent.requester.toLowerCase()),
      reason: "Worker requester principal authorized",
    },
    {
      ruleId: "category.allow",
      passed: policy.allowedCategories.includes(intent.category),
      reason: `Category '${intent.category}' permitted`,
    },
    {
      ruleId: "vendor.lcbFloor",
      passed: intent.vendorLcbScoreBps >= policy.minVendorLcbBps,
      reason: `Vendor LCB ${intent.vendorLcbScoreBps} bps >= floor ${policy.minVendorLcbBps} bps`,
    },
    {
      ruleId: "intent.maxAmountBound",
      passed: intent.amountUsd > 0 && Number.isFinite(intent.amountUsd),
      reason: `Bounded positive amount ($${intent.amountUsd.toFixed(2)})`,
    },
    {
      ruleId: "hardCap.absolute",
      passed: intent.amountUsd <= 10_000,
      reason: "Within protocol absolute ceiling ($10,000)",
    },
    {
      ruleId: "perCall.cap",
      passed: intent.amountUsd <= policy.perCallCapUsd,
      reason:
        intent.amountUsd <= policy.perCallCapUsd
          ? `Amount $${intent.amountUsd.toFixed(2)} <= per-call cap $${policy.perCallCapUsd.toFixed(2)}`
          : `Exceeds per-call cap ($${intent.amountUsd.toFixed(2)} > $${policy.perCallCapUsd.toFixed(2)})`,
    },
    {
      ruleId: "budget.daily",
      passed: effectiveUsage <= policy.dailyBudgetUsd,
      reason:
        effectiveUsage <= policy.dailyBudgetUsd
          ? `Effective daily usage $${effectiveUsage.toFixed(2)} <= $${policy.dailyBudgetUsd.toFixed(2)}`
          : `Daily budget exceeded ($${effectiveUsage.toFixed(2)} > $${policy.dailyBudgetUsd.toFixed(2)})`,
    },
    {
      ruleId: "rate.limit",
      passed: policy.callsInLastHour < policy.maxCallsPerHour,
      reason: `Hourly rate ${policy.callsInLastHour + 1}/${policy.maxCallsPerHour}`,
    },
    {
      ruleId: "sla.latencyBound",
      passed: intent.reportedLatencyMs <= intent.maxLatencyMs,
      reason:
        intent.reportedLatencyMs <= intent.maxLatencyMs
          ? `Reported latency ${intent.reportedLatencyMs}ms <= SLA ${intent.maxLatencyMs}ms`
          : `SLA breached (${intent.reportedLatencyMs}ms > ${intent.maxLatencyMs}ms) -> SLASH`,
    },
    {
      ruleId: "escalate.aboveThreshold",
      passed: intent.amountUsd <= policy.escalationThresholdUsd,
      reason:
        intent.amountUsd <= policy.escalationThresholdUsd
          ? "Below human escalation threshold"
          : "Requires human quote-hash approval signature",
    },
  ];

  const hardFailures = rules.slice(0, 14).filter((r) => !r.passed);
  const needsEscalation = !rules[14].passed;
  const passedCount = rules.filter((r) => r.passed).length;

  let verdict: "ALLOW" | "ESCALATE" | "BLOCK" = "ALLOW";
  if (hardFailures.length > 0) {
    verdict = "BLOCK";
  } else if (needsEscalation) {
    verdict = "ESCALATE";
  }

  return {
    verdict,
    passedCount,
    totalRules: rules.length,
    rules,
    effectiveDailyUsageUsd: effectiveUsage,
    canonicalDigest: computeCanonicalDigest(intent),
  };
}

export interface CycleOrder {
  wallet: string;
  sellAsset: string;
  buyAsset: string;
  amountUsd: number;
}

export interface CycleMatchResult {
  matchedLegs: Array<{ fromWallet: string; toWallet: string; asset: string; amountUsd: number }>;
  totalInputUsd: number;
  crossedUsd: number;
  residualUsd: number;
  efficiencyBps: number;
  cycleLength: number;
}

/**
 * Finds 2-way and 3-way complementary rebalancing cycles across intents
 * so offsetting flows settle peer-to-peer before touching AMM pools.
 */
export function solveComplementaryCycles(orders: CycleOrder[]): CycleMatchResult {
  const totalInputUsd = orders.reduce((acc, o) => acc + o.amountUsd, 0);
  if (orders.length === 0 || totalInputUsd === 0) {
    return { matchedLegs: [], totalInputUsd: 0, crossedUsd: 0, residualUsd: 0, efficiencyBps: 0, cycleLength: 0 };
  }

  // Check for a 3-way cycle: A sells X for Y, B sells Y for Z, C sells Z for X
  if (orders.length >= 3) {
    const [a, b, c] = orders;
    if (a.buyAsset === b.sellAsset && b.buyAsset === c.sellAsset && c.buyAsset === a.sellAsset) {
      const clearAmount = Math.min(a.amountUsd, b.amountUsd, c.amountUsd);
      const crossedUsd = Math.round(clearAmount * 3 * 100) / 100;
      const residualUsd = Math.max(0, Math.round((totalInputUsd - crossedUsd) * 100) / 100);
      return {
        matchedLegs: [
          { fromWallet: a.wallet, toWallet: c.wallet, asset: a.sellAsset, amountUsd: clearAmount },
          { fromWallet: b.wallet, toWallet: a.wallet, asset: b.sellAsset, amountUsd: clearAmount },
          { fromWallet: c.wallet, toWallet: b.wallet, asset: c.sellAsset, amountUsd: clearAmount },
        ],
        totalInputUsd,
        crossedUsd,
        residualUsd,
        efficiencyBps: Math.round((crossedUsd / totalInputUsd) * 10000),
        cycleLength: 3,
      };
    }
  }

  // Check for 2-way bilateral cross: A sells X for Y, B sells Y for X
  if (orders.length >= 2) {
    const [a, b] = orders;
    if (a.sellAsset === b.buyAsset && a.buyAsset === b.sellAsset) {
      const clearAmount = Math.min(a.amountUsd, b.amountUsd);
      const crossedUsd = Math.round(clearAmount * 2 * 100) / 100;
      const residualUsd = Math.max(0, Math.round((totalInputUsd - crossedUsd) * 100) / 100);
      return {
        matchedLegs: [
          { fromWallet: a.wallet, toWallet: b.wallet, asset: a.sellAsset, amountUsd: clearAmount },
          { fromWallet: b.wallet, toWallet: a.wallet, asset: b.sellAsset, amountUsd: clearAmount },
        ],
        totalInputUsd,
        crossedUsd,
        residualUsd,
        efficiencyBps: Math.round((crossedUsd / totalInputUsd) * 10000),
        cycleLength: 2,
      };
    }
  }

  return {
    matchedLegs: [],
    totalInputUsd,
    crossedUsd: 0,
    residualUsd: totalInputUsd,
    efficiencyBps: 0,
    cycleLength: 0,
  };
}

export const POLICY_RULES = [
  { id: "POL-01", name: "policy.active", check: "Policy active and intent within deadline TTL" },
  { id: "POL-02", name: "duplicate.tupleGuard", check: "Unique provider/capability/amount tuple inside window" },
  { id: "POL-03", name: "cooldown.sameService", check: "Minimum cooldown elapsed since prior settlement" },
  { id: "POL-04", name: "replay.nonceBinding", check: "EIP-712 nonce unused in replay registry" },
  { id: "POL-05", name: "recipient.allowList", check: "Counterparty address verified against policy allowlist" },
  { id: "POL-06", name: "worker.principalAuth", check: "Requester signer principal authorized" },
  { id: "POL-07", name: "category.permitted", check: "Execution category permitted by mandate" },
  { id: "POL-08", name: "vendor.lcbFloor", check: "Counterparty reputation LCB above floor bps" },
  { id: "POL-09", name: "intent.positiveBound", check: "Strictly positive finite notional amount" },
  { id: "POL-10", name: "hardCap.protocolCeiling", check: "Notional within protocol absolute ceiling" },
  { id: "POL-11", name: "perCall.mandateCap", check: "Notional within per-settlement mandate cap" },
  { id: "POL-12", name: "budget.dailyEnvelope", check: "Settled + reserved spend within 24h budget" },
  { id: "POL-13", name: "rate.hourlyWindow", check: "Settlement count within hourly rate limit" },
  { id: "POL-14", name: "sla.latencyBound", check: "Execution finality within SLA latency bound" },
  { id: "POL-15", name: "escalate.quoteThreshold", check: "High-value intents require human quote signature" },
] as const;

