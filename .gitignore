# Whitelist. Everything at the top level is ignored unless it is listed here.
/*

# Source
!/app/
!/components/
!/contracts/
!/db/
!/indexer/
!/lib/
!/public/
!/tests/
!/tools/
!/fixtures/
!/scripts/
!/docs/
!/.github/

# Project files
!/.gitignore
!/.env.example
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/next.config.ts
!/next-env.d.ts
!/postcss.config.mjs
!/tailwind.config.ts
!/eslint.config.mjs
!/drizzle.config.ts
!/foundry.toml
!/vercel.json
!/Makefile

# Documents and evidence
!/README.md
!/LICENSE
!/SECURITY.md
!/CREDITS.md
!/DESIGN.md
!/AGENTS.md
!/CLAUDE.md
!/CLAIM_LEDGER.md
!/WHAT_IS_REAL.md
!/PROOF_RUNS.json
!/LIVE_RUN.json

# The deployment record the app and the verifier read, and the theme mirror.
!/.kit/
/.kit/*
!/.kit/deployment.json
!/.kit/theme.json

# Never, even inside a listed folder.
node_modules/
out/
.next/
.DS_Store
*.tsbuildinfo
.env
.env.*
!.env.example
public/audio/
docs/demo.mp4
docs/fallback.mp4
scripts/deploy_solana_devnet.sh
scripts/deploy_starknet_sepolia.sh
