{
  "name": "web3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.mjs",
    "contracts:build": "forge build",
    "contracts:test": "forge test -vvv",
    "claim:verify": "tsx tools/claim-verify.ts",
    "verify:flow": "pnpm claim:verify",
    "verify:system": "pnpm claim:verify",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "indexer:catchup": "tsx indexer/cli.ts catchup",
    "indexer:daemon": "tsx indexer/cli.ts daemon",
    "proof:local": "tsx tools/local-proof.ts",
    "contracts:test:fork": "forge test --match-contract CreditVaultTest --fork-url ${MONAD_RPC:-https://testnet-rpc.monad.xyz}"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "utf-8-validate",
      "bufferutil"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.3",
    "wagmi": "3.7.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
